<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>2.1.0</version>
        <id>datatables.net-staterestore-bm</id>
        <description>This is StateRestore for DataTables with styling for [Bulma](https://bulma.io/)</description>
        <repository type="git" url="https://github.com/DataTables/StateRestore"/>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="expression">MIT</license>
        <tags>StateRestore  stateSave  state reload  Bulma  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-staterestore" version="2.1.0"/>
            <dependency id="datatables.net-bm" version="^3.1"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/stateRestore.bulma.js" target="content\Scripts"/>
        <file src="js/stateRestore.bulma.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/stateRestore.bulma.min.js" target="content\Scripts"/>
        <file src="js/stateRestore.bulma.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/stateRestore.bulma.min.mjs" target="content\Scripts"/>
        <file src="js/stateRestore.bulma.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/stateRestore.bulma.mjs" target="content\Scripts"/>
        <file src="js/stateRestore.bulma.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/stateRestore.bulma.css" target="content\Content"/>
        <file src="css/stateRestore.bulma.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/stateRestore.bulma.min.css" target="content\Content"/>
        <file src="css/stateRestore.bulma.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
